# Variables de entorno para producción en PythonAnywhere
# Copiar este contenido a un archivo .env en el servidor

# Django Settings
SECRET_KEY=tu-secret-key-muy-seguro-aqui
DEBUG=False
ALLOWED_HOSTS=tu-usuario.pythonanywhere.com

# Base de datos MySQL
DB_NAME=tu-usuario$gestor_pos
DB_USER=tu-usuario
DB_PASSWORD=tu-password-mysql
DB_HOST=tu-usuario.mysql.pythonanywhere-services.com
DB_PORT=3306

# URLs y dominios
FRONTEND_URL=https://tu-usuario.pythonanywhere.com
BACKEND_URL=https://tu-usuario.pythonanywhere.com

# CORS
CORS_ALLOWED_ORIGINS=https://tu-usuario.pythonanywhere.com

# Configuración adicional (opcional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-password-email
